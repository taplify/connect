generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  MANAGER
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum NFCOrderStatus {
  PENDING
  PAID
  CANCELLED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts                Account[]
  sessions                Session[]
  personalProfile         PersonalProfile?
  cards                   DigitalBusinessCard[]
  organizationMemberships OrganizationMember[]
  subscriptions           Subscription[]
  nfcCards                NFCCard[]
  nfcOrders               NFCOrder[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PersonalProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String?
  jobTitle  String?
  company   String?
  biography String?  @db.Text
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigitalBusinessCard {
  id             String   @id @default(cuid())
  ownerId        String
  organizationId String?
  title          String
  slug           String   @unique
  isPublished    Boolean  @default(false)
  accentColor    String   @default("#1E85FF")
  fontFamily     String   @default("Poppins")
  layout         String   @default("classic")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections     BusinessCardSection[]
  nfcCards     NFCCard[]
  nfcOrders    NFCOrder[]
  interactions CardInteraction[]

  @@index([ownerId])
  @@index([organizationId])
}

model BusinessCardSection {
  id        String   @id @default(cuid())
  cardId    String
  type      String
  title     String?
  data      Json
  position  Int      @default(0)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card DigitalBusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  logoUrl        String?
  website        String?
  primaryColor   String   @default("#1E85FF")
  secondaryColor String   @default("#1A1A1A")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  cards       DigitalBusinessCard[]
  departments Department[]
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(EMPLOYEE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole @default(EMPLOYEE)
  status         InvitationStatus @default(PENDING)
  token          String           @unique
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    EmployeeProfile[]

  @@unique([organizationId, name])
}

model EmployeeProfile {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  departmentId   String?
  fullName       String
  email          String?
  phone          String?
  jobTitle       String?
  cardId         String?  @unique
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([departmentId])
  @@index([userId])
}

model NFCCard {
  id                 String    @id @default(cuid())
  ownerId            String?
  identifier         String    @unique
  activationCodeHash String?   @unique
  name               String
  tagType            String
  isActive           Boolean   @default(true)
  isReadyForSale     Boolean   @default(false)
  activatedAt        DateTime?
  cardId             String?
  tapCount           Int       @default(0)
  lastTappedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  card  DigitalBusinessCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  owner User?                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  order NFCOrder?

  @@index([cardId])
  @@index([ownerId])
}

model NFCOrder {
  id                      String         @id @default(cuid())
  userId                  String
  cardId                  String?
  cardTitle               String
  nfcCardId               String?        @unique
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?        @unique
  status                  NFCOrderStatus @default(PENDING)
  amountTotal             Int
  currency                String
  shippingName            String?
  shippingPhone           String?
  shippingAddress         String?        @db.Text
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  card    DigitalBusinessCard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  nfcCard NFCCard?             @relation(fields: [nfcCardId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model CardInteraction {
  id        String   @id @default(cuid())
  cardId    String
  type      String
  source    String?
  visitorId String?
  createdAt DateTime @default(now())

  card DigitalBusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, createdAt])
  @@index([type, createdAt])
}

model Contact {
  id           String   @id @default(cuid())
  ownerId      String
  name         String
  email        String?
  phone        String?
  company      String?
  notes        String?  @db.Text
  tags         String[] @default([])
  sourceCardId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([sourceCardId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  cardId    String
  ownerId   String
  name      String
  email     String?
  phone     String?
  company   String?
  message   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
  @@index([cardId, createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  plan      String
  status    SubscriptionStatus @default(TRIALING)
  periodEnd DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UploadedAsset {
  id        String   @id @default(cuid())
  ownerId   String
  url       String
  type      String
  name      String
  size      Int
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}
